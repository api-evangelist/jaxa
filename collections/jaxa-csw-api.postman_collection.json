  "info": {
    "_postman_id": "8dfa1d52-7d88-490a-abd8-802c4449a59f",
    "name": "G-Portal Web CSW API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "OGC-compliant web services for searching and accessing JAXA Earth observation satellite products from missions including GCOM-W (AMSR2), GCOM-C (SGLI), and GSMaP precipitation products. Provides Catalog Services for the Web (CSW) for data search, Web Map Service (WMS) for image rendering, and Web Coverage Service (WCS) for raw coverage data retrieval.\n\nContact Support:\n Name: JAXA Satellite Applications and Operations Center",
      "type": "text/plain"
    }
  }
